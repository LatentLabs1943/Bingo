# Local browser demo. Set false when connecting a real Telegram bot.
DEMO_MODE=true
BOT_TOKEN=
# Telegram requires a public HTTPS URL for the Mini App.
WEBAPP_URL=https://your-domain.example
DATABASE_PATH=data/bingo.sqlite3
# Vercel: use a PostgreSQL URL (prefer the provider's pooled connection URL).
# Leave empty for the existing local SQLite demo.
DATABASE_URL=
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Configure the same secret locally and in Vercel before registering the webhook.
TELEGRAM_WEBHOOK_SECRET=
# Vercel enables this automatically; set true to test request-driven timing locally.
SERVERLESS_MODE=false
REGISTRATION_SECONDS=60
CALL_INTERVAL_SECONDS=6
RESULT_SECONDS=20
ENTRY_CREDITS=10
STARTING_CREDITS=1000
# Maximum age of signed Telegram launch data (seconds).
AUTH_MAX_AGE_SECONDS=86400
# Maximum reserved cards in a round (each player can still reserve up to 2).
SEAT_LIMIT=20
# Distinct players required before the registration countdown begins.
MIN_PLAYERS=2
# Comma-separated numeric Telegram user IDs. Empty disables admin access.
ADMIN_TELEGRAM_IDS=
# Bootstrap the bot owner; only this signed-in Telegram ID can grant admin access.
OWNER_TELEGRAM_ID=
# practice keeps fictional balances; manual uses a separate real-balance ledger.
# manual requires DEMO_MODE=false and OWNER_TELEGRAM_ID. No automatic bank transfers.
FUNDS_MODE=practice
# Receiving bank/mobile-money name, account, and beneficiary (owner can edit in app).
DEPOSIT_INSTRUCTIONS=

